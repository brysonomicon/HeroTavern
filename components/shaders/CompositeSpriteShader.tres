[gd_resource type="VisualShader" format=3 uid="uid://dva44swuu0kah"]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_lysyn"]
input_name = "texture"

[sub_resource type="VisualShaderNodeTexture" id="VisualShaderNodeTexture_eoch6"]
source = 5

[sub_resource type="VisualShaderNodeTexture2DParameter" id="VisualShaderNodeTexture2DParameter_k05c0"]
parameter_name = "default_palette"

[sub_resource type="VisualShaderNodeTexture2DParameter" id="VisualShaderNodeTexture2DParameter_qq7ws"]
parameter_name = "new_palette"

[sub_resource type="VisualShaderNodeIntParameter" id="VisualShaderNodeIntParameter_fwi4d"]
parameter_name = "colors_count"
default_value_enabled = true
default_value = 2

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_fxdlw"]
size = Vector2(600, 640)
expression = "vec2 new_uv = vec2(0,0);
for(int i = 0; i < colors_count; ++i)
{
	// + 0.5 to ensure we don't hit the edge of each colored pixel
	// otherwise results could be ambiguous
	float u = (float(i) + 0.5) / float(colors_count);
	// Check the middle of the 1 pixel box
	float v = 0.5;
	vec2 uv = vec2(u, v);
	vec4 default_color = texture(default_palette, uv);
	float dist = distance(color, default_color);
	
	if(dist == 0.0)
	{
		new_uv = uv;
		break;	
	}
}

new_color = texture(new_palette, new_uv);"

